# ---- PlatformIO / build artifacts ------------------------------------------
.pio/
.cache
.dummy
sdkconfig.*
compile_commands.json

# ---- Editor / tooling -------------------------------------------------------
# c_cpp_properties.json and launch.json are machine-generated and contain
# absolute local paths (including the Windows username), so they stay untracked.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Machine-local Claude Code settings (permissions, local paths). A shared
# .claude/settings.json, if one is ever added, stays tracked.
.claude/settings.local.json

# VS Code "Local History" extension: mirrors whole files on every save and can
# contain its own nested .git directory.
.history/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]

# ---- OS / archive noise -----------------------------------------------------
__MACOSX/
.DS_Store
Thumbs.db
